{
  "name": "@babojubot/process",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./recovery": "./src/recovery.ts",
    "./remove-folder": "./src/remove-folder.ts",
    "./test-cleanup": "./src/test-cleanup.ts",
    "./lifelines": "./src/lifeline-support.ts",
    "./fs-swap": "./src/fs-swap-support.ts",
    "./testing": "./src/testing.ts",
    "./test-support": "./src/test-support.ts",
    "./launcher-setup": "./src/launcher-setup-support.ts"
  },
  "scripts": {
    "build": "node supervisor/build.mjs",
    "test": "vitest run && vitest run --config vitest.alone.config.ts",
