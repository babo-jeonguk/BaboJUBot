    "typecheck:src": "tsc -p tsconfig.src.json",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@babojubot/contracts": "workspace:*",
    "cross-spawn": "7.0.6"
