{
  "provenance": "Synthetic protocol example; not a model recording. Shape of a stream-json run whose first turn leaves a background command running: after stdin closes, Claude waits for the command, takes one more turn with its outcome and exits (code.claude.com/docs/en/headless.md#background-tasks-at-exit).",
  "steps": [
    { "input": { "type": "user", "message": { "role": "user" } } },
    {
      "frame": {
        "type": "system",
        "subtype": "init",
        "session_id": "session-bg"
      }
    },
    {
      "frame": {
        "type": "system",
        "subtype": "task_started",
        "task_id": "bash-1",
        "task_type": "local_bash",
        "description": "sleep 45"
      }
    },
    {
      "frame": {
        "type": "result",
        "subtype": "success",
        "session_id": "session-bg",
        "total_cost_usd": 0.01,
        "usage": { "input_tokens": 10, "output_tokens": 3 }
      }
    },
    { "inputEnd": true },
    { "sleepMs": 2500 },
    {
      "frame": {
        "type": "system",
        "subtype": "task_notification",
        "task_id": "bash-1",
        "status": "completed"
      }
    },
    {
      "frame": {
        "type": "result",
        "subtype": "success",
        "session_id": "session-bg",
        "total_cost_usd": 0.03,
        "usage": { "input_tokens": 5, "output_tokens": 4 }
      }
    },
    { "exit": 0 }
  ]
}
