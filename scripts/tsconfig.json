// eslint.config.js가 개발 스크립트를 타입 정보로 검사할 때 쓰고, pnpm typecheck:js(scripts/typecheck-js.mjs)가 타입 검사한다.
// JS를 .ts로 옮기기 전까지 암시적 any만 끈다(#270 PR 3a). 옮긴 영역은 제품 코드와 같은 엄격 설정을 받는다.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": { "checkJs": true, "noImplicitAny": false },
  "include": ["**/*"],
  // 시험 실패 종료 코드 확인의 vitest 전역(`it`)은 그 폴더의 설정만 받는다(fixtures/test-exit-code/tsconfig.json).
  "exclude": ["fixtures/test-exit-code"]
}
