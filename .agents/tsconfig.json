// eslint.config.js가 agent 도구 스크립트를 타입 정보로 검사할 때 쓰고, pnpm typecheck:js(scripts/typecheck-js.mjs)가 타입 검사한다.
// JS를 .ts로 옮기기 전까지 암시적 any만 끈다(#270 PR 3a). 옮긴 영역은 제품 코드와 같은 엄격 설정을 받는다.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": { "checkJs": true, "noImplicitAny": false },
  "include": ["**/*"]
}
