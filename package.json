{
  "name": "babojubot",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @babojubot/server --filter @babojubot/web run dev",
    "start": "pnpm --filter @babojubot/server run start",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test && pnpm run test:root",
    "test:root": "node scripts/check-test-exit-code.mjs && node scripts/run-node-tests.mjs boot-check",
    "test:e2e": "pnpm --filter @babojubot/web run test:e2e",
    "typecheck": "pnpm -r --if-present run typecheck && pnpm run typecheck:tools && pnpm run typecheck:js",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:js": "node scripts/typecheck-js.mjs",
    "typecheck:src": "pnpm -r --if-present run typecheck:src",
    "typecheck:test": "pnpm -r --if-present run typecheck:test",
    "lint": "eslint .",
    "check": "pnpm run check:docs && pnpm run check:rules && pnpm run check:agents && pnpm run check:scripts",
    "check:docs": "node scripts/check-project.mjs && node scripts/check-code-map.mjs",
    "check:rules": "node scripts/run-node-tests.mjs check-rules",
    "check:agents": "node scripts/run-node-tests.mjs check-agents",
    "check:scripts": "node scripts/run-node-tests.mjs check-scripts",
    "verify:changed": "node scripts/verify-changed.mjs",
    "provider:login": "node scripts/provider-login.mjs",
    "runner:build": "docker build -t babojubot-runner docker/runner",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babojubot/contracts": "workspace:*",
    "@babojubot/db": "workspace:*",
    "@babojubot/process": "workspace:*",
    "@babojubot/runtime": "workspace:*",
    "@babojubot/server": "workspace:*",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  }
}
